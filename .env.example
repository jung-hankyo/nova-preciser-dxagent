# Copy to .env and fill in. Never commit .env.
# v0.4.2 default profile: DeepSeek runs the agent, OpenAI runs the simulated environment and the judge.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=          # only for the Anthropic profile below
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Spec options after "?": DeepSeek thinking=off|low|high|max (default off); OpenAI reasoning effort=minimal|low|medium|high
DX_DOCTOR_MODEL=deepseek:deepseek-v4-pro?thinking=low       # extraction, hypotheses, interview, critic, report; also the LLM-only baseline
DX_CARD_MODEL=deepseek:deepseek-v4-pro                      # offline compile extraction (verbatim quotes) and contrast cards
DX_PRIOR_MODEL=deepseek:deepseek-flash                      # S-only prior assessor (bucket choice)
DX_PATIENT_MODEL=openai:gpt-5-mini?effort=minimal           # simulated patient: a different family from the doctor
DX_MEASUREMENT_MODEL=openai:gpt-5-mini?effort=minimal       # reads the case's fixed exam/test table
DX_JUDGE_MODEL=openai:gpt-5-mini?effort=medium              # grades diagnoses; not the doctor's family

# Anthropic profile (same roles):
# DX_DOCTOR_MODEL=anthropic:claude-sonnet-5-5
# DX_CARD_MODEL=anthropic:claude-sonnet-5-5
# DX_PRIOR_MODEL=anthropic:claude-haiku-4-5-20251001
# DX_JUDGE_MODEL=anthropic:claude-sonnet-5-5
# Leave DX_TEMPERATURE unset: reasoning models and DeepSeek thinking mode ignore or reject it.
# DX_PRICES='{"deepseek-flash": [0.30, 0.006, 1.20]}'       # override list prices used for the report's cost estimate
# DX_TEMPERATURE=0

# Knowledge layer
# Knowledge layer (v0.4): compiled offline from cited sources; nothing is drafted during a case.
# DX_KB_DIR=./kb                    # compiled knowledge base (dxagent kb compile)
# DX_SOURCES_DIR=./sources          # manifest.yaml, ontology files, source documents (gitignored)
# DX_CACHE_DIR=./cache              # run-time contrast cards, provisional cards, learned aliases
DX_LOCAL_FALLBACK=1                 # primary fallback: compile a missing disease mid-case from the documents in sources/ (on_demand)
# DX_LOCAL_FALLBACK_MAX_DOCS=4      # documents searched per missing disease
# DX_FALLBACK_MAX=2                 # missing diseases compiled per turn
DX_LIVE_FALLBACK=0                  # secondary: PubMed SR/MA/guideline abstracts when the local documents have nothing (provisional)
# DX_LIVE_FALLBACK_CONF_CAP=0.5
DX_CONTRAST=1                       # LLM contrast cards for live confusable pairs (existing codes only, capped)
# DX_CONTRAST_CONF_CAP=0.55
# DX_CONTRAST_SAMPLES=3
# DX_INHERIT_DEPTH=3                # a card-less disease inherits its nearest carded ontology ancestor
# DX_INHERIT_DECAY=0.9              # confidence factor per inherited level
# DX_TREE=1                         # listed ancestor/descendant diseases form a tree, not rivals
# DX_TARGET_POPULATION=adult        # compiler: population the cards are for (others get a directness discount)
# DX_HPO_SCOPE=all                  # compiler: all | listed | none
# DX_DERIVED_BG_MIN=0.02            # compiler: floor for backgrounds derived from the cards
# DX_DERIVED_BG_RARE_SHARE=0.05     # compiler: HPO-only cards together get at most this weight
# DX_CONTRAST_MIN_PROB=0.10
DX_REVERSE_INDEX=1                # add known diseases the evidence supports, even if the LLM missed them
# DX_REVERSE_MIN_PROB=0.05        # join if the disease would reach this probability
# DX_REVERSE_MAX=2                # at most this many per turn
# DX_REVERSE_PRIOR=0.02           # prior assigned to index-added diseases       # both diseases at least this likely -> elicit an A-vs-B contrast card
# v0.3.1 prior context (P1): the prior conditions only on age, sex, setting, and the primary complaint.
DX_PRIOR_CONTEXT=1                # 1: S-only prior assessor on every route; 0: v0.3 (the generator's bucket)
# DX_PRIOR_MODEL=anthropic:claude-haiku-4-5-20251001   # the assessor sees only S; a small model suffices (empty: doctor model)
# DX_PRIOR_SAMPLES=3              # assessor self-consistency samples (median bucket); 1 costs ~4 fewer LLM calls per case
# DX_PRIOR_RECONCILE=2            # card prevalence vs assessor this many buckets apart: meet in the middle
# DX_PRIOR_SENS_ALPHA=0.5         # diagnostic only: tempered-prior check in the final report
# DX_OBJECTIVE=accuracy           # accuracy (benchmark) | clinical (harm-weighted confusions)
# DX_SAFETY_WEIGHT=1.0            # clinical mode only
# DX_KB_PERTURB=1                 # robustness check factor (1 = off)

# Planner and stopping (defaults shown)
# DX_MISDIAGNOSIS_LOSS=10
# DX_PAIR_WEIGHT=2.0
# DX_COST_WEIGHT=0.001
# DX_TURN_COST=0.03
# DX_COMMIT_THRESHOLD=0.80
# DX_EXCLUSION_THRESHOLD=0.03
# DX_MIN_COMMIT_PROB=0.40
# DX_MIN_TURNS=4
# DX_MAX_TURNS=60                 # hard cap per case (use 20 to compare with published AgentClinic numbers)
# DX_STALL_TURNS=3
# DX_MAX_BATCH_HISTORY=3
# DX_MAX_BATCH_TESTS=3
